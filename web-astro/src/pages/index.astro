            <div class="ide-code-scroll" id="ideCodeScroll">
              <pre class="ide-code-pre"><code class="hljs" id="ideCodeOutput"></code></pre>
            </div>

            <!-- Image Preview -->
            <div class="ide-image-preview" id="ideImagePreview" style="display: none;">
              <div class="image-preview-card">
                <div class="image-preview-header">
                  <span class="icon">🖼️</span>
                  <strong id="ideImageTitle">Previsualización de Imagen</strong>
                </div>
                <div class="image-preview-body">
                  <img id="idePreviewImg" src="" alt="Vista previa" />
                </div>
                <div class="image-preview-info" id="ideImageInfo">
                  Ruta del proyecto: <code>assets/images/...</code>
                </div>
              </div>
            </div>
          </div>

        </section>

      </div>
    </div>
  </div>

  <!-- CHECKLIST MODAL -->
  <div class="modal-overlay" id="checklistModal">
    <div class="modal-window">
      <div class="modal-head">
        <h3>📋 Checklist Obligatorio de Entrega</h3>
        <button class="close-btn" id="closeChecklistBtn">&times;</button>
      </div>

      <ul class="check-items-list">
        <li>
          <label class="check-item">
            <input type="checkbox" id="chk-author" />
            <div><strong>1. package.json:</strong> He puesto mi nombre y apellidos en <code>"author": "..."</code> y la versión.</div>
          </label>
        </li>
        <li>
          <label class="check-item">
            <input type="checkbox" id="chk-http" />
            <div><strong>2. main.ts:</strong> He añadido <code>provideHttpClient(withFetch())</code> en providers.</div>
          </label>
        </li>
        <li>
          <label class="check-item">
            <input type="checkbox" id="chk-swiper" />
            <div><strong>3. Swiper:</strong> He llamado a <code>register()</code> en <code>app.component.ts</code> y añadido <code>CUSTOM_ELEMENTS_SCHEMA</code> en la página de diapositivas.</div>
          </label>
        </li>
        <li>
          <label class="check-item">
            <input type="checkbox" id="chk-menu" />
            <div><strong>4. Conexión Menú:</strong> El <code>contentId</code> de <code>&lt;ion-menu&gt;</code> coincide con el <code>id</code> de <code>&lt;ion-content&gt;</code>.</div>
          </label>
        </li>
        <li>
          <label class="check-item">
            <input type="checkbox" id="chk-complete" />
            <div><strong>5. complete() en eventos:</strong> Tanto el Infinite Scroll como el Refresher llaman a <code>event.target.complete()</code>.</div>
          </label>
        </li>
        <li>
          <label class="check-item">
            <input type="checkbox" id="chk-console" />
            <div><strong>6. Consola limpia (F12):</strong> He abierto DevTools y no hay ningún error en rojo al navegar o interactuar.</div>
          </label>
        </li>
        <li>
          <label class="check-item">
            <input type="checkbox" id="chk-recording" />
            <div><strong>7. Grabación activa:</strong> He iniciado el software de captura de pantalla antes de empezar la prueba.</div>
          </label>
        </li>
      </ul>

      <div style="margin-top: 24px; text-align: right;">
        <button class="btn-checklist" id="closeChecklistBottomBtn" style="margin-left: auto;">
          Entendido / Guardar
        </button>
      </div>
    </div>
  </div>

  <footer>
    <p>Guía de Resolución Rápida para Examen SGE - {lastUpdated}</p>
  </footer>

  <!-- Highlight.js Standalone IIFE (Offline & file:/// Compatible) -->
  <script is:inline src="./highlighter.bundle.js"></script>

  <!-- Client-side Interactive Scripts -->
  <script is:inline>
    // Initialize Syntax Highlighting
    if (window.hljs) {
      window.hljs.highlightAll();
    }

    // Elements
    const searchInput = document.getElementById('globalSearch');
    const cards = document.querySelectorAll('.model-card');
    const tagButtons = document.querySelectorAll('.tag-chip');
    const filterNotice = document.getElementById('filterNotice');
    const filterName = document.getElementById('filterName');
    const matchCount = document.getElementById('matchCount');
    const btnResetFilter = document.getElementById('btnResetFilter');
    let currentFilter = 'all';

    function resetAllFilters() {
      currentFilter = 'all';
      if (searchInput) searchInput.value = '';
      tagButtons.forEach(b => b.classList.remove('active'));
      const allBtn = document.querySelector('.tag-chip[data-filter="all"]');
      if (allBtn) allBtn.classList.add('active');
      applyFilters();
    }

    btnResetFilter?.addEventListener('click', resetAllFilters);

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach(card => {
        const text = card.innerText.toLowerCase();
        const tags = (card.dataset.tags || '').toLowerCase();

        const matchQuery = query === '' || text.includes(query);
        const matchFilter = currentFilter === 'all' || tags.includes(currentFilter);

        if (matchQuery && matchFilter) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Update Filter Notice Bar
      const isFiltered = currentFilter !== 'all' || query !== '';
      if (isFiltered && filterNotice) {
        filterNotice.classList.add('show');
        if (filterName) {
          const activeTagBtn = document.querySelector('.tag-chip.active');
          const tagLabel = activeTagBtn ? activeTagBtn.innerText : currentFilter;
          filterName.innerText = query !== '' ? `Texto: "${query}" ${currentFilter !== 'all' ? '(' + tagLabel + ')' : ''}` : tagLabel;
        }
        if (matchCount) matchCount.innerText = visibleCount.toString();
      } else if (filterNotice) {
        filterNotice.classList.remove('show');
      }
    }

    searchInput?.addEventListener('input', applyFilters);

    tagButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        tagButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.dataset.filter || 'all';
        applyFilters();
      });
    });

    // Sidebar (Índice Rápido) - Siempre funciona sin importar el filtro
    document.querySelectorAll('.toc-link').forEach(link => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('href');
        if (!targetId || !targetId.startsWith('#')) return;

        // 1. Si hay filtro o búsqueda activa, resetear para que la tarjeta sea visible
        if (currentFilter !== 'all' || (searchInput && searchInput.value.trim() !== '')) {
          resetAllFilters();
        }

        // 2. Navegación suave y resalte visual
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          e.preventDefault();
          targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
          targetElement.classList.remove('card-highlight');
          void targetElement.offsetWidth; // Forzar repintado
          targetElement.classList.add('card-highlight');
          history.pushState(null, null, targetId);
        }
      });
    });

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey && e.key.toLowerCase() === 'f') || (e.key === '/' && document.activeElement !== searchInput)) {
        e.preventDefault();
        searchInput?.focus();
        searchInput?.select();
      }
      if (e.key === 'Escape') {
        closeModal();
      }
    });

    // Copy to Clipboard
    document.querySelectorAll('.btn-copy').forEach(btn => {
      btn.addEventListener('click', () => {
        const codeElement = btn.closest('.code-box')?.querySelector('code');
        if (!codeElement) return;

        navigator.clipboard.writeText(codeElement.innerText).then(() => {
          const original = btn.innerText;
          btn.innerText = '✅ ¡Copiado!';
          btn.style.background = '#10b981';
          btn.style.color = '#090d16';
          setTimeout(() => {
            btn.innerText = original;
            btn.style.background = '';
            btn.style.color = '';
          }, 1500);
        });
      });
    });

    // Modal Checklist
    const modal = document.getElementById('checklistModal');
    const openBtn = document.getElementById('openChecklistBtn');
    const closeBtn = document.getElementById('closeChecklistBtn');
    const closeBottomBtn = document.getElementById('closeChecklistBottomBtn');

    function openModal() { modal?.classList.add('active'); }
    function closeModal() { modal?.classList.remove('active'); }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    closeBottomBtn?.addEventListener('click', closeModal);

    // Save and load checklist from localStorage
    const checkboxes = document.querySelectorAll('.check-item input[type="checkbox"]');
    function saveChecks() {
      const state = {};
      checkboxes.forEach(chk => {
        state[chk.id] = chk.checked;
      });
      localStorage.setItem('sge_astro_checks', JSON.stringify(state));
    }

    function loadChecks() {
      const raw = localStorage.getItem('sge_astro_checks');
      if (raw) {
        try {
          const state = JSON.parse(raw);
          checkboxes.forEach(chk => {
            if (state[chk.id]) chk.checked = true;
          });
        } catch(e) {}
      }
    }

    checkboxes.forEach(chk => chk.addEventListener('change', saveChecks));
    loadChecks();
  </script>

  <!-- Zelda Files Data & IDE Controller -->
  <script is:inline src="/zelda-files.js"></script>
  <script is:inline src="/zelda-ide.js"></script>
</body>
</html>