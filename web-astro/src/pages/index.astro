---
// Astro Component Server-Side Script
const pageTitle = "SGE Examen Progresa - Guía Rápida Ionic v8 & Angular Standalone";
const lastUpdated = "Noviembre 2026 - Francisco Belda";
---

<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-body: #090d16;
      --bg-surface: #0f172a;
      --bg-card: #141e33;
      --bg-subtle: #1e293b;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --accent: #38bdf8;
      --accent-glow: rgba(56, 189, 248, 0.2);
      --accent-hover: #0284c7;
      --border: #22324e;
      --border-focus: #38bdf8;
      --code-bg: #070b14;
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background-color: var(--bg-body);
      color: var(--text-main);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Top Sticky Header */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(9, 13, 22, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      padding: 12px 24px;
    }

    .header-inner {
      max-width: 1440px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .top-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 14px;
    }

    .logo-area {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-icon {
      font-size: 1.6rem;
      font-weight: 900;
    }

    .logo-text h1 {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #fff;
    }

    .badge-pill {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .badge-ionic {
      background: rgba(56, 189, 248, 0.15);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.3);
    }

    .badge-belda {
      background: rgba(16, 185, 129, 0.15);
      color: #10b981;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    /* Search Input */
    .search-bar-container {
      position: relative;
      flex: 1;
      max-width: 580px;
      min-width: 280px;
    }

    .search-input {
      width: 100%;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 10px 18px 10px 42px;
      color: #fff;
      font-size: 0.92rem;
      outline: none;
      transition: all 0.2s ease;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.3);
    }

    .search-input:focus {
      border-color: var(--border-focus);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .search-icon-svg {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
      font-size: 1rem;
    }

    .shortcut-hint {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 0.7rem;
      font-family: 'Fira Code', monospace;
      background: var(--code-bg);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 2px 6px;
      border-radius: 4px;
    }

    .btn-checklist {
      background: linear-gradient(135deg, #0284c7, #2563eb);
      color: #fff;
      border: none;
      padding: 9px 18px;
      border-radius: var(--radius-md);
      font-size: 0.86rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
      box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
    }

    .btn-checklist:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(2, 132, 199, 0.45);
    }

    /* Tag Filters */
    .filter-tags {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: none;
    }

    .filter-tags::-webkit-scrollbar {
      display: none;
    }

    .tag-chip {
      background: var(--bg-surface);
      color: var(--text-muted);
      border: 1px solid var(--border);
      padding: 5px 14px;
      border-radius: 9999px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s ease;
    }

    .tag-chip:hover {
      background: var(--bg-subtle);
      color: #fff;
      border-color: #3b82f6;
    }

    .tag-chip.active {
      background: var(--accent);
      color: #090d16;
      border-color: var(--accent);
      font-weight: 800;
      box-shadow: 0 2px 8px var(--accent-glow);
    }

    /* Layout Grid */
    .app-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 24px;
      display: grid;
      grid-template-columns: 290px 1fr;
      gap: 28px;
      flex: 1;
      width: 100%;
    }

    @media (max-width: 1040px) {
      .app-container {
        grid-template-columns: 1fr;
      }
      .toc-sidebar {
        display: none;
      }
    }

    /* Sidebar Navigation */
    .toc-sidebar {
      position: sticky;
      top: 140px;
      max-height: calc(100vh - 160px);
      overflow-y: auto;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 18px;
      scrollbar-width: thin;
    }

    .toc-title {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      font-weight: 800;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .toc-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .toc-link {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.84rem;
      font-weight: 500;
      transition: all 0.15s ease;
    }

    .toc-link:hover {
      background: var(--bg-subtle);
      color: #fff;
    }

    .toc-link .num {
      font-family: 'Fira Code', monospace;
      font-size: 0.75rem;
      color: var(--accent);
      font-weight: 700;
    }

    /* Critical Golden Rules Banner */
    .golden-banner {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(185, 28, 28, 0.25) 100%);
      border: 1px solid rgba(239, 68, 68, 0.4);
      border-radius: var(--radius-lg);
      padding: 20px;
      margin-bottom: 28px;
      position: relative;
      overflow: hidden;
    }

    .golden-banner::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 5px;
      background: var(--danger);
    }

    .golden-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .golden-header h2 {
      font-size: 1.15rem;
      font-weight: 800;
      color: #fecaca;
    }

    .golden-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 12px;
      margin-top: 14px;
    }

    .golden-card {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(239, 68, 68, 0.25);
      border-radius: var(--radius-md);
      padding: 12px 14px;
      font-size: 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .golden-card strong {
      color: #f87171;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Model Cards */
    .models-feed {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .model-card {
      scroll-margin-top: 155px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: all 0.2s ease;
    }

    @keyframes pulseGlow {
      0% { box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.8); border-color: #38bdf8; }
      50% { box-shadow: 0 0 0 12px rgba(56, 189, 248, 0.25); border-color: #38bdf8; }
      100% { box-shadow: 0 0 0 0 rgba(56, 189, 248, 0); }
    }

    .card-highlight {
      animation: pulseGlow 1.6s ease-out;
      border-color: #38bdf8 !important;
    }

    .active-filter-bar {
      display: none;
      background: rgba(56, 189, 248, 0.1);
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 10px 16px;
      border-radius: var(--radius-md);
      margin-bottom: 20px;
      align-items: center;
      justify-content: space-between;
      font-size: 0.88rem;
    }

    .active-filter-bar.show {
      display: flex;
    }

    .btn-reset-filter {
      background: var(--accent);
      color: #090d16;
      border: none;
      border-radius: 9999px;
      padding: 4px 12px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
    }

    .model-card:hover {
      border-color: #3b82f6;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
    }

    .card-top {
      padding: 18px 24px;
      background: #0f192b;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .card-id-title {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .card-num {
      background: var(--accent);
      color: #090d16;
      font-family: 'Fira Code', monospace;
      font-size: 0.85rem;
      font-weight: 900;
      padding: 4px 10px;
      border-radius: var(--radius-sm);
    }

    .card-title {
      font-size: 1.22rem;
      font-weight: 800;
      color: #fff;
    }

    .trigger-pill {
      background: rgba(56, 189, 248, 0.1);
      color: var(--accent);
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 5px 12px;
      border-radius: 9999px;
      font-size: 0.78rem;
      font-family: 'Fira Code', monospace;
      font-weight: 600;
    }

    .card-content {
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    /* Anatomy & Steps */
    .info-callout {
      background: var(--bg-surface);
      border-left: 4px solid var(--accent);
      padding: 12px 16px;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      font-size: 0.88rem;
    }

    .info-callout strong {
      color: var(--accent);
    }

    .recipe-steps {
      padding-left: 20px;
      font-size: 0.92rem;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .recipe-steps li strong {
      color: #fff;
    }

    /* Code Blocks */
    .code-box {
      background: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      overflow: hidden;
    }

    .code-bar {
      background: #090d16;
      padding: 8px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
      font-family: 'Fira Code', monospace;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .btn-copy {
      background: var(--bg-subtle);
      color: var(--text-main);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 4px 10px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 5px;
      transition: all 0.15s;
    }

    .btn-copy:hover {
      background: var(--accent);
      color: #090d16;
      border-color: var(--accent);
    }

    pre {
      padding: 16px;
      overflow-x: auto;
      font-family: 'Fira Code', Consolas, Monaco, monospace;
      font-size: 0.85rem;
      color: #e2e8f0;
      line-height: 1.6;
    }



    /* Teacher Criteria & Traps */
    .rubric-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    @media (max-width: 768px) {
      .rubric-grid {
        grid-template-columns: 1fr;
      }
    }

    .rubric-card {
      border-radius: var(--radius-md);
      padding: 14px 18px;
      font-size: 0.85rem;
    }

    .rubric-positive {
      background: rgba(16, 185, 129, 0.08);
      border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .rubric-positive h4 {
      color: var(--success);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .rubric-negative {
      background: rgba(239, 68, 68, 0.08);
      border: 1px solid rgba(239, 68, 68, 0.25);
    }

    .rubric-negative h4 {
      color: var(--danger);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .rubric-card ul {
      padding-left: 18px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    /* Directory Tree Visualization */
    .tree-card {
      background: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      overflow: hidden;
      margin: 14px 0;
    }

    .tree-header {
      background: #090d16;
      padding: 8px 16px;
      font-family: 'Fira Code', monospace;
      font-size: 0.8rem;
      color: var(--accent);
      border-bottom: 1px solid var(--border);
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .tree-content {
      padding: 16px;
      margin: 0;
      font-family: 'Fira Code', Consolas, Monaco, monospace;
      font-size: 0.86rem;
      line-height: 1.6;
      white-space: pre !important;
      overflow-x: auto;
      color: #e2e8f0;
    }

    .tree-content .folder {
      color: #38bdf8;
      font-weight: 700;
    }

    .tree-content .file {
      color: #f1f5f9;
      font-weight: 600;
    }

    .tree-content .comment {
      color: #64748b;
      font-style: italic;
    }

    /* Interactive Checklist Modal */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(4, 7, 13, 0.8);
      backdrop-filter: blur(6px);
      z-index: 200;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-window {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      max-width: 650px;
      width: 100%;
      padding: 26px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    }

    .modal-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 12px;
    }

    .modal-head h3 {
      font-size: 1.25rem;
      color: var(--accent);
      font-weight: 800;
    }

    .close-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1.6rem;
      cursor: pointer;
      line-height: 1;
    }

    .check-items-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .check-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 0.92rem;
      cursor: pointer;
      padding: 8px 10px;
      border-radius: var(--radius-sm);
      transition: background 0.15s;
    }

    .check-item:hover {
      background: var(--bg-card);
    }

    .check-item input[type="checkbox"] {
      margin-top: 4px;
      width: 20px;
      height: 20px;
      accent-color: var(--accent);
      cursor: pointer;
    }

    /* Footer */
    footer {
      border-top: 1px solid var(--border);
      padding: 24px;
      text-align: center;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-top: auto;
      background: var(--bg-surface);
    }
  </style>

  <style is:global>
/* =========================================
   VIEW MODE SWITCHER (HEADER)
   ========================================= */
.view-mode-bar {
  display: flex;
  gap: 10px;
  margin-top: 10px;
  border-top: 1px solid var(--border, #22324e);
  padding-top: 10px;
  overflow-x: auto;
}

.view-mode-btn {
  background: var(--bg-surface, #0f172a);
  color: var(--text-muted, #94a3b8);
  border: 1px solid var(--border, #22324e);
  border-radius: var(--radius-md, 10px);
  padding: 8px 16px;
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s;
  white-space: nowrap;
}

.view-mode-btn:hover {
  background: var(--bg-subtle, #1e293b);
  color: #fff;
  border-color: #38bdf8;
}

.view-mode-btn.active {
  background: linear-gradient(135deg, #0284c7, #2563eb);
  color: #fff;
  border-color: #38bdf8;
  box-shadow: 0 4px 14px rgba(2, 132, 199, 0.4);
}

.btn-badge {
  background: rgba(0, 0, 0, 0.35);
  color: #38bdf8;
  padding: 2px 7px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-family: 'Fira Code', monospace;
}

.view-mode-btn.active .btn-badge {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

/* Sidebar IDE Promo Card */
.sidebar-ide-card {
  margin-bottom: 14px;
  border-radius: var(--radius-md, 10px);
  background: linear-gradient(135deg, rgba(2, 132, 199, 0.15), rgba(37, 99, 235, 0.25));
  border: 1px solid rgba(56, 189, 248, 0.3);
  padding: 10px;
}

.btn-open-ide {
  width: 100%;
  background: transparent;
  border: none;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.82rem;
  cursor: pointer;
  text-align: left;
}

.btn-open-ide:hover strong {
  color: #38bdf8;
}

.btn-open-ide .icon {
  font-size: 1.3rem;
}

/* =========================================
   IDE WORKSPACE LAYOUT & STYLES
   ========================================= */
.ide-view-container {
  max-width: 1540px;
  margin: 0 auto;
  padding: 16px 20px 40px 20px;
  width: 100%;
}

.ide-window {
  background: #0d1117;
  border: 1px solid #30363d;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.7);
  display: flex;
  flex-direction: column;
  min-height: 820px;
}

.ide-titlebar {
  background: #161b22;
  border-bottom: 1px solid #30363d;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  font-size: 0.82rem;
  user-select: none;
}

.ide-traffic-lights {
  display: flex;
  gap: 6px;
  align-items: center;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}

.dot-red { background: #ff5f56; }
.dot-yellow { background: #ffbd2e; }
.dot-green { background: #27c93f; }

.ide-titlebar-title {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #c9d1d9;
}

.ide-title-badge {
  background: rgba(56, 189, 248, 0.15);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.3);
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 0.72rem;
}

.btn-ide-switch-back {
  background: #21262d;
  color: #c9d1d9;
  border: 1px solid #30363d;
  border-radius: 6px;
  padding: 5px 12px;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s;
}

.btn-ide-switch-back:hover {
  background: #30363d;
  color: #fff;
  border-color: #8b949e;
}

.ide-quickbar {
  background: #0d1117;
  border-bottom: 1px solid #21262d;
  padding: 8px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  overflow-x: auto;
}

.quickbar-label {
  font-size: 0.76rem;
  font-weight: 700;
