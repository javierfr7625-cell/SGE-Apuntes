              <pre><code class="language-typescript">import &#123; Component, inject, OnInit &#125; from '@angular/core';
import &#123; InfiniteScrollCustomEvent &#125; from '@ionic/angular';
import &#123; DataService &#125; from '../../services/data.service';

export class InfinitePage implements OnInit &#123;
  private dataService = inject(DataService);
  items: any[] = [];
  currentPage = 1;

  ngOnInit() &#123;
    this.loadData();
  &#125;

  loadData(event?: InfiniteScrollCustomEvent) &#123;
    this.dataService.getItems(this.currentPage).subscribe(&#123;
      next: (res) =&gt; &#123;
        this.items.push(...res.results);

        // 1. COMPLETAR SIEMPRE EL EVENTO
        event?.target.complete();

        // 2. DESACTIVAR AL LLEGAR AL FINAL DE LA COLECCIÓN
        if (event && res.total_pages === this.currentPage) &#123;
          event.target.disabled = true;
          return;
        &#125;

        this.currentPage++;
      &#125;,
      error: (err) =&gt; &#123;
        console.error(err);
        event?.target.complete();
      &#125;
    &#125;);
  &#125;
&#125;</code></pre>
